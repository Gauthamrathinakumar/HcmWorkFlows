{
	"info": {
		"_postman_id": "d5e6f7a8-b9c0-1d2e-3f4a-5b6c7d8e9f0a",
		"name": "Oracle HCM - Worker & User Sync (Custom Schema)",
		"description": "Replicates a Worker using custom schema (JobCode, LegislationCode GLOBAL, DepartmentName, AssignmentCategory, Expense Account, Managers) and creates the User Account with PROD security roles in Lower Env.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Fetch Worker Details from PROD",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"var pNum = pm.collectionVariables.get('person_number');",
							"",
							"if (pm.response.code === 200 && jsonData.items && jsonData.items.length > 0) {",
							"    var worker = jsonData.items[0];",
							"    ",
							"    // 1. Names Mapping (Using LegislationCode: GLOBAL)",
							"    var namesArray = [];",
							"    if (worker.names && worker.names.items && worker.names.items.length > 0) {",
							"        worker.names.items.forEach(function(n) {",
							"            namesArray.push({",
							"                \"LegislationCode\": n.LegislationCode || \"GLOBAL\",",
							"                \"LastName\": n.LastName || \"Emp\",",
							"                \"FirstName\": n.FirstName || \"Test\"",
							"            });",
							"        });",
							"    } else {",
							"        namesArray.push({",
							"            \"LegislationCode\": \"GLOBAL\",",
							"            \"LastName\": \"TestUser\",",
							"            \"FirstName\": \"Test\"",
							"        });",
							"    }",
							"    ",
							"    // 2. Emails Mapping (Masked for Lower Env safety)",
							"    var emailsArray = [];",
							"    if (worker.emails && worker.emails.items && worker.emails.items.length > 0) {",
							"        worker.emails.items.forEach(function(e) {",
							"            var orig = e.EmailAddress || (namesArray[0].FirstName + '.' + namesArray[0].LastName + '@company.com');",
							"            var masked = orig.replace(/@(.*)$/, '@test.invalid');",
							"            emailsArray.push({",
							"                \"EmailType\": e.EmailType || \"W1\",",
							"                \"EmailAddress\": masked",
							"            });",
							"        });",
							"    } else {",
							"        emailsArray.push({",
							"            \"EmailType\": \"W1\",",
							"            \"EmailAddress\": namesArray[0].FirstName + '.' + namesArray[0].LastName + '@test.invalid'",
							"        });",
							"    }",
							"    ",
							"    // 3. Work Relationships & Assignments Mapping",
							"    var workRelArray = [];",
							"    if (worker.workRelationships && worker.workRelationships.items) {",
							"        worker.workRelationships.items.forEach(function(wr) {",
							"            var asgArray = [];",
							"            if (wr.assignments && wr.assignments.items) {",
							"                wr.assignments.items.forEach(function(a) {",
							"                    var asgObj = {",
							"                        \"ActionCode\": \"HIRE\",",
							"                        \"BusinessUnitName\": a.BusinessUnitName",
							"                    };",
							"                    if (a.JobCode) asgObj.JobCode = a.JobCode;",
							"                    if (a.DepartmentName) asgObj.DepartmentName = a.DepartmentName;",
							"                    if (a.AssignmentCategory) asgObj.AssignmentCategory = a.AssignmentCategory;",
							"                    if (a.PermanentTemporary) asgObj.PermanentTemporary = a.PermanentTemporary;",
							"                    if (a.DefaultExpenseAccount) asgObj.DefaultExpenseAccount = a.DefaultExpenseAccount;",
							"                    ",
							"                    // Managers Mapping",
							"                    if (a.managers && a.managers.items && a.managers.items.length > 0) {",
							"                        var mgrList = [];",
							"                        a.managers.items.forEach(function(m) {",
							"                            if (m.ManagerAssignmentNumber) {",
							"                                mgrList.push({",
							"                                    \"ManagerAssignmentNumber\": m.ManagerAssignmentNumber,",
							"                                    \"ManagerType\": m.ManagerType || \"LINE_MANAGER\"",
							"                                });",
							"                            }",
							"                        });",
							"                        if (mgrList.length > 0) {",
							"                            asgObj.managers = mgrList;",
							"                        }",
							"                    }",
							"                    asgArray.push(asgObj);",
							"                });",
							"            }",
							"            ",
							"            workRelArray.push({",
							"                \"LegalEmployerName\": wr.LegalEmployerName,",
							"                \"WorkerType\": wr.WorkerType || \"E\",",
							"                \"PrimaryFlag\": true,",
							"                \"assignments\": asgArray",
							"            });",
							"        });",
							"    }",
							"    ",
							"    // 4. Assemble Exact Target Schema",
							"    var workerPayload = {",
							"        \"PersonNumber\": pNum,",
							"        \"workRelationships\": workRelArray,",
							"        \"names\": namesArray,",
							"        \"emails\": emailsArray",
							"    };",
							"    ",
							"    pm.collectionVariables.set('worker_payload_json', JSON.stringify(workerPayload, null, 2));",
							"    console.log('[PROD] Built Worker Payload:\n', JSON.stringify(workerPayload, null, 2));",
							"    pm.test('Worker successfully fetched from PROD', function() { pm.expect(worker.PersonNumber).to.eql(pNum); });",
							"} else {",
							"    pm.expect.fail('Worker not found in PROD for PersonNumber: ' + pNum);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"auth": {
					"type": "basic",
					"basic": [
						{"key": "username", "value": "{{prod_user}}", "type": "string"},
						{"key": "password", "value": "{{prod_pass}}", "type": "string"}
					]
				},
				"method": "GET",
				"header": [{"key": "Accept", "value": "application/json"}],
				"url": {
					"raw": "{{prod_url}}/hcmRestApi/resources/11.13.18.05/workers?q=PersonNumber={{person_number}}&expand=names,emails,workRelationships.assignments.managers",
					"host": ["{{prod_url}}"],
					"path": ["hcmRestApi", "resources", "11.13.18.05", "workers"],
					"query": [
						{"key": "q", "value": "PersonNumber={{person_number}}"},
						{"key": "expand", "value": "names,emails,workRelationships.assignments.managers"}
					]
				}
			}
		},
		{
			"name": "2. Check Worker in Lower Env",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"if (jsonData.items && jsonData.items.length > 0) {",
							"    pm.collectionVariables.set('target_worker_exists', 'true');",
							"    console.log('[LOWER ENV] Worker already exists.');",
							"} else {",
							"    pm.collectionVariables.set('target_worker_exists', 'false');",
							"    console.log('[LOWER ENV] Worker does not exist. Creating Worker...');",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"auth": {
					"type": "basic",
					"basic": [
						{"key": "username", "value": "{{lower_user}}", "type": "string"},
						{"key": "password", "value": "{{lower_pass}}", "type": "string"}
					]
				},
				"method": "GET",
				"header": [{"key": "Accept", "value": "application/json"}],
				"url": {
					"raw": "{{lower_url}}/hcmRestApi/resources/11.13.18.05/workers?q=PersonNumber={{person_number}}",
					"host": ["{{lower_url}}"],
					"path": ["hcmRestApi", "resources", "11.13.18.05", "workers"],
					"query": [
						{"key": "q", "value": "PersonNumber={{person_number}}"}
					]
				}
			}
		},
		{
			"name": "3. Create Worker in Lower Env",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var workerExists = pm.collectionVariables.get('target_worker_exists');",
							"if (workerExists !== 'true') {",
							"    pm.test('Worker Created Successfully (HTTP 201/200)', function () {",
							"        pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
							"    });",
							"    if (pm.response.code === 201 || pm.response.code === 200) {",
							"        console.log('[LOWER ENV] Worker record created.');",
							"    } else {",
							"        console.error('[LOWER ENV] Worker creation failed: ' + pm.response.text());",
							"    }",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"auth": {
					"type": "basic",
					"basic": [
						{"key": "username", "value": "{{lower_user}}", "type": "string"},
						{"key": "password", "value": "{{lower_pass}}", "type": "string"}
					]
				},
				"method": "POST",
				"header": [
					{"key": "Content-Type", "value": "application/vnd.oracle.adf.resourceitem+json"},
					{"key": "Accept", "value": "application/json"}
				],
				"body": {
					"mode": "raw",
					"raw": "{{worker_payload_json}}"
				},
				"url": {
					"raw": "{{lower_url}}/hcmRestApi/resources/11.13.18.05/workers",
					"host": ["{{lower_url}}"],
					"path": ["hcmRestApi", "resources", "11.13.18.05", "workers"]
				}
			}
		},
		{
			"name": "4. Fetch User Account & Roles from PROD",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"var username = '';",
							"var roles = [];",
							"",
							"if (pm.response.code === 200 && jsonData.items && jsonData.items.length > 0) {",
							"    var user = jsonData.items[0];",
							"    username = user.Username;",
							"    if (user.userRoleDetails && user.userRoleDetails.items) {",
							"        user.userRoleDetails.items.forEach(function(r) {",
							"            if (r.RoleCommonName) {",
							"                roles.push({ \"RoleCommonName\": r.RoleCommonName });",
							"            }",
							"        });",
							"    }",
							"} else {",
							"    username = pm.collectionVariables.get('person_number');",
							"}",
							"",
							"pm.collectionVariables.set('extracted_username', username);",
							"var userPayload = {",
							"    \"Username\": username,",
							"    \"PersonNumber\": pm.collectionVariables.get('person_number'),",
							"    \"Suspended\": false,",
							"    \"Password\": pm.collectionVariables.get('default_test_password'),",
							"    \"userRoleDetails\": roles",
							"};",
							"pm.collectionVariables.set('user_payload_json', JSON.stringify(userPayload, null, 2));",
							"console.log('[PROD] Built User Payload:\n', JSON.stringify(userPayload, null, 2));"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"auth": {
					"type": "basic",
					"basic": [
						{"key": "username", "value": "{{prod_user}}", "type": "string"},
						{"key": "password", "value": "{{prod_pass}}", "type": "string"}
					]
				},
				"method": "GET",
				"header": [{"key": "Accept", "value": "application/json"}],
				"url": {
					"raw": "{{prod_url}}/hcmRestApi/resources/11.13.18.05/userAccounts?q=PersonNumber={{person_number}}&expand=userRoleDetails",
					"host": ["{{prod_url}}"],
					"path": ["hcmRestApi", "resources", "11.13.18.05", "userAccounts"],
					"query": [
						{"key": "q", "value": "PersonNumber={{person_number}}"},
						{"key": "expand", "value": "userRoleDetails"}
					]
				}
			}
		},
		{
			"name": "5. Check User in Lower Env",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"if (jsonData.items && jsonData.items.length > 0) {",
							"    pm.collectionVariables.set('target_user_exists', 'true');",
							"} else {",
							"    pm.collectionVariables.set('target_user_exists', 'false');",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"auth": {
					"type": "basic",
					"basic": [
						{"key": "username", "value": "{{lower_user}}", "type": "string"},
						{"key": "password", "value": "{{lower_pass}}", "type": "string"}
					]
				},
				"method": "GET",
				"header": [{"key": "Accept", "value": "application/json"}],
				"url": {
					"raw": "{{lower_url}}/hcmRestApi/resources/11.13.18.05/userAccounts?q=Username='{{extracted_username}}'",
					"host": ["{{lower_url}}"],
					"path": ["hcmRestApi", "resources", "11.13.18.05", "userAccounts"],
					"query": [
						{"key": "q", "value": "Username='{{extracted_username}}'"}
					]
				}
			}
		},
		{
			"name": "6. Create User Account in Lower Env",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var userExists = pm.collectionVariables.get('target_user_exists');",
							"if (userExists !== 'true') {",
							"    pm.test('User Account & Roles Created in Lower Env', function () {",
							"        pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
							"    });",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"auth": {
					"type": "basic",
					"basic": [
						{"key": "username", "value": "{{lower_user}}", "type": "string"},
						{"key": "password", "value": "{{lower_pass}}", "type": "string"}
					]
				},
				"method": "POST",
				"header": [
					{"key": "Content-Type", "value": "application/vnd.oracle.adf.resourceitem+json"},
					{"key": "Accept", "value": "application/json"}
				],
				"body": {
					"mode": "raw",
					"raw": "{{user_payload_json}}"
				},
				"url": {
					"raw": "{{lower_url}}/hcmRestApi/resources/11.13.18.05/userAccounts",
					"host": ["{{lower_url}}"],
					"path": ["hcmRestApi", "resources", "11.13.18.05", "userAccounts"]
				}
			}
		}
	],
	"variable": [
		{"key": "person_number", "value": "WD000005", "type": "string"},
		{"key": "prod_url", "value": "https://fa-xxxx-saasfaprod1.fa.ocs.oraclecloud.com", "type": "string"},
		{"key": "prod_user", "value": "PROD_API_USER", "type": "string"},
		{"key": "prod_pass", "value": "YourProdPassword", "type": "string"},
		{"key": "lower_url", "value": "https://fa-xxxx-test.fa.ocs.oraclecloud.com", "type": "string"},
		{"key": "lower_user", "value": "TEST_API_USER", "type": "string"},
		{"key": "lower_pass", "value": "YourTestPassword", "type": "string"},
		{"key": "default_test_password", "value": "Welcome#12345", "type": "string"},
		{"key": "worker_payload_json", "value": "{}", "type": "string"},
		{"key": "user_payload_json", "value": "{}", "type": "string"},
		{"key": "target_worker_exists", "value": "false", "type": "string"},
		{"key": "target_user_exists", "value": "false", "type": "string"},
		{"key": "extracted_username", "value": "", "type": "string"}
	]
}
