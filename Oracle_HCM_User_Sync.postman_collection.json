{
	"info": {
		"name": "Oracle HCM - PROD to Lower Env User Sync",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Fetch User & Roles from PROD",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"if (jsonData.items && jsonData.items.length > 0) {",
							"    var user = jsonData.items[0];",
							"    pm.collectionVariables.set('extracted_username', user.Username);",
							"    var roles = [];",
							"    if (user.userRoleDetails && user.userRoleDetails.items) {",
							"        user.userRoleDetails.items.forEach(function(r) {",
							"            if (r.RoleCommonName) {",
							"                roles.push({ 'RoleCommonName': r.RoleCommonName });",
							"            }",
							"        });",
							"    }",
							"    pm.collectionVariables.set('extracted_roles_json', JSON.stringify(roles));",
							"    console.log('Successfully fetched ' + user.Username + ' with ' + roles.length + ' roles.');",
							"} else {",
							"    pm.expect.fail('User not found in PROD for PersonNumber ' + pm.collectionVariables.get('person_number'));",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"auth": {
					"type": "basic",
					"basic": [
						{"key": "username", "value": "{{prod_user}}", "type": "string"},
						{"key": "password", "value": "{{prod_pass}}", "type": "string"}
					]
				},
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{prod_url}}/hcmRestApi/resources/11.13.18.05/userAccounts?q=PersonNumber={{person_number}}&expand=userRoleDetails",
					"host": ["{{prod_url}}"],
					"path": ["hcmRestApi", "resources", "11.13.18.05", "userAccounts"],
					"query": [
						{"key": "q", "value": "PersonNumber={{person_number}}"},
						{"key": "expand", "value": "userRoleDetails"}
					]
				}
			}
		},
		{
			"name": "2. Create User in Lower Env",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"var username = pm.collectionVariables.get('extracted_username');",
							"var personNumber = pm.collectionVariables.get('person_number');",
							"var password = pm.collectionVariables.get('default_test_password');",
							"var roles = JSON.parse(pm.collectionVariables.get('extracted_roles_json') || '[]');",
							"",
							"var payload = {",
							"    'Username': username,",
							"    'PersonNumber': personNumber,",
							"    'Suspended': false,",
							"    'Password': password,",
							"    'userRoleDetails': roles",
							"};",
							"",
							"pm.request.body.raw = JSON.stringify(payload);"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"auth": {
					"type": "basic",
					"basic": [
						{"key": "username", "value": "{{lower_user}}", "type": "string"},
						{"key": "password", "value": "{{lower_pass}}", "type": "string"}
					]
				},
				"method": "POST",
				"header": [
					{"key": "Content-Type", "value": "application/json"}
				],
				"body": {
					"mode": "raw",
					"raw": "{}"
				},
				"url": {
					"raw": "{{lower_url}}/hcmRestApi/resources/11.13.18.05/userAccounts",
					"host": ["{{lower_url}}"],
					"path": ["hcmRestApi", "resources", "11.13.18.05", "userAccounts"]
				}
			}
		}
	],
	"variable": [
		{"key": "person_number", "value": "100234"},
		{"key": "prod_url", "value": "https://your-prod-pod.oraclecloud.com"},
		{"key": "prod_user", "value": "PROD_USER"},
		{"key": "prod_pass", "value": "PROD_PASSWORD"},
		{"key": "lower_url", "value": "https://your-test-pod.oraclecloud.com"},
		{"key": "lower_user", "value": "TEST_USER"},
		{"key": "lower_pass", "value": "TEST_PASSWORD"},
		{"key": "default_test_password", "value": "Welcome#12345"},
		{"key": "extracted_username", "value": ""},
		{"key": "extracted_roles_json", "value": "[]"}
	]
}
